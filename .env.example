# Belong - Campus Lost & Found Configuration
# Copy this file to .env and adjust variables as needed

# Security
SECRET_KEY=belong-insecure-dev-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (PostgreSQL by default)
# To use SQLite for lightweight testing or initial run, set DB_ENGINE=django.db.backends.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=belong_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Campus Configuration
# Optional: Set to restrict registration domain (e.g. campus.edu). Leave empty for open/demo mode.
CAMPUS_ALLOWED_EMAIL_DOMAIN=

# Workflow Settings
ITEM_AGING_DAYS_THRESHOLD=30
OTP_EXPIRY_MINUTES=15
MAX_UPLOAD_SIZE_MB=5
